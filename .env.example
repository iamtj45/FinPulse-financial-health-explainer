# Generation — provider-agnostic, OpenAI-compatible endpoints only.
# Recommended: Groq (free, fastest) as primary.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Fallback — used on rate-limit or 5xx from the primary.
# Recommended: Cerebras (free).
LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=llama-3.3-70b

# Embeddings — Groq/Cerebras don't serve embeddings, so this is a separate
# provider. EMBED_PROVIDER is "jina" or "cohere" (lib/embed.ts implements
# both; their endpoints and request shapes are fixed per provider, unlike
# the arbitrary OpenAI-compatible LLM_BASE_URL above).
EMBED_PROVIDER=jina
EMBED_API_KEY=
EMBED_MODEL=jina-embeddings-v3
