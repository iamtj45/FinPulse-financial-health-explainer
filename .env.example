# Template only. Copy this to .env.local and fill in real keys there —
# .env.local is gitignored, this file is NOT (see .gitignore), so a key
# left here gets published on the first push.

# Generation — provider-agnostic, OpenAI-compatible endpoints only.
# Recommended: Groq (free, no card). Note llama-3.3-70b-versatile was
# retired on 2026-08-16; openai/gpt-oss-120b is Groq's replacement.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional fallback — used on a rate-limit, 5xx, or a retired/unknown model


# Embeddings — Groq/Cerebras don't serve embeddings, so this is a separate
# provider. EMBED_PROVIDER is "jina" or "cohere" (lib/embed.ts implements
# both; their endpoints and request shapes are fixed per provider, unlike
# the arbitrary OpenAI-compatible LLM_BASE_URL above).
#
# jina-embeddings-v3 is 1024-dim and matches the committed
# content/kb-index.json. Changing EMBED_MODEL requires re-running
# `npm run build-kb-index`, or retrieval falls back to tag matching.
EMBED_PROVIDER=jina
EMBED_API_KEY=
EMBED_MODEL=jina-embeddings-v3
